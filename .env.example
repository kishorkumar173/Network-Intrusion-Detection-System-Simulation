# Network IDS Simulation Environment Configuration
FLASK_ENV=development
FLASK_APP=backend.app:create_app
FLASK_PORT=5000
DATABASE_PATH=data/network_ids.db
ENABLE_ML=true
MODEL_PATH=models/random_forest_ids.joblib
BASELINE_PATH=models/baseline_stats.json

# Hybrid Detection Weights (Must sum to 1.0)
WEIGHT_RULE=0.40
WEIGHT_ANOMALY=0.30
WEIGHT_ML=0.30

# Correlation settings
CORRELATION_WINDOW_SECONDS=60
